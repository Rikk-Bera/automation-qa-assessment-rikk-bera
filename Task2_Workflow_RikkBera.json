      "name": "Get GitHub Repositories",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -912,
        32
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const repos = $input.first().json.items || [];\n\nreturn repos.slice(0, 5).map(repo => ({\n  json: {\n    name: repo.full_name,\n    owner: repo.owner.login,\n    repo: repo.name,\n    stars: repo.stargazers_count,\n    url: repo.html_url,\n    description: repo.description\n  }\n}));"
      },
      "id": "3e30e86d-1680-467c-b958-296b332be3f5",
      "name": "Select Top 5",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -688,
        -80
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.owner }}/{{ $json.repo }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "n8n"
            }
          ]
        },
        "options": {}
      },
      "id": "5f62be70-01c2-4616-aa58-c57b4b096686",
      "name": "Enrich Repository",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -480,
        -80
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json)\n  .sort((a, b) => b.stargazers_count - a.stargazers_count);\n\nconst lines = items.map((r, i) =>\n  `${i + 1}. ${r.full_name}\\n   ⭐ ${r.stargazers_count} | 🍴 ${r.forks_count} | 🐛 ${r.open_issues_count}\\n   ${r.html_url}`\n);\nconst popular = items.filter(r => r.stargazers_count > 1000).length;\n\nreturn [{\n  json: {\n    digest: `☀️ Morning Brief — Top Python Repos\\n\\n${lines.join('\\n\\n')}`,\n    total: items.length,\n    popularCount: popular\n  }\n}];"
      },
      "id": "5064fa7f-e88e-4cf5-a1c9-19da3129e668",
      "name": "Build Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -256,
        -80
      ]
    },
