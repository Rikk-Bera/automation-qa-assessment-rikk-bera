    {
      "parameters": {
        "jsCode": "const cfg = $('Config and Timer').first().json;\nconst first = $('Evaluate Check').first().json;\nconst r = $input.first().json;\n\nconst esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst retryStatus = r.statusCode ?? 0;\nconst isUp = retryStatus === 200;\nconst error = r.error ? (r.error.message || String(r.error)) : first.error;\nconst checkedAt = new Date().toISOString();\n\nconst alertText =\n  `🚨 <b>APP DOWN</b>\\n\\n` +\n  `URL: ${esc(cfg.url)}\\n` +\n  `First check status: ${first.statusCode} (0 = no response)\\n` +\n  `Retry status: ${retryStatus}\\n` +\n  `Error: ${esc(error || 'none')}\\n` +\n  `Time: ${checkedAt}`;\n\nreturn [{ json: { url: cfg.url, isUp, retryStatus, alertText } }];"
      },
