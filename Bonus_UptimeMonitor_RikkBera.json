      "id": "8c6eba62-455c-4798-b87f-aabe2bdad254",
      "name": "Ping Web App",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -688,
        112
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config and Timer').first().json;\nconst r = $input.first().json;\n\nconst statusCode = r.statusCode ?? 0;          // 0 = no response at all (timeout / DNS / network)\nconst responseTimeMs = Date.now() - cfg.startedAt;\nconst isUp = statusCode === 200;\n\n// Track stats for the daily summary (persists while the workflow is published)\nconst s = $getWorkflowStaticData('global');\ns.checks = (s.checks || 0) + 1;\nif (!isUp) s.failures = (s.failures || 0) + 1;\ns.totalMs = (s.totalMs || 0) + responseTimeMs;\ns.maxMs = Math.max(s.maxMs || 0, responseTimeMs);\ns.url = cfg.url;\n\nreturn [{\n  json: {\n    url: cfg.url,\n    statusCode,\n    responseTimeMs,\n    isUp,\n    error: r.error ? (r.error.message || String(r.error)) : null,\n    checkedAt: new Date().toISOString()\n  }\n}];"
      },
