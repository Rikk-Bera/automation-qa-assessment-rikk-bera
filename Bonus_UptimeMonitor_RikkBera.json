    {
      "parameters": {
        "jsCode": "const s = $getWorkflowStaticData('global');\nconst esc = t => String(t ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst checks = s.checks || 0;\nconst fails = s.failures || 0;\nconst avg = checks ? Math.round((s.totalMs || 0) / checks) : 0;\nconst uptime = checks ? (((checks - fails) / checks) * 100).toFixed(2) : 'n/a';\n\nconst text =\n  `📊 <b>Daily Uptime Summary</b>\\n\\n` +\n  `URL: ${esc(s.url || 'n/a')}\\n` +\n  `Checks: ${checks}\\n` +\n  `Failed checks: ${fails}\\n` +\n  `Uptime: ${uptime}%\\n` +\n  `Avg response: ${avg} ms\\n` +\n  `Slowest: ${s.maxMs || 0} ms`;\n\n// reset for the next day\ns.checks = 0; s.failures = 0; s.totalMs = 0; s.maxMs = 0;\n\nreturn [{ json: { text } }];"
      },
